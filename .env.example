# Telegram
BOT_TOKEN=your_telegram_bot_token

# kie.ai
KIE_API_KEY=your_kie_api_key
KIE_API_URL=https://kie.ai

# OpenRouter (замена OpenAI для работы из РФ)
OPENROUTER_API_KEY=your_openrouter_api_key
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# Прокси для OpenRouter — Cloudflare отдаёт 403 на российские IP.
# http://user:pass@host:port или socks5://host:port (нужен httpx[socks]).
# Пусто = ходить напрямую (тогда сработает локальный фолбэк промптов).
OPENROUTER_PROXY=

# YooKassa
YOOKASSA_SHOP_ID=your_shop_id
YOOKASSA_SECRET_KEY=your_secret_key
YOOKASSA_RETURN_URL=https://t.me/your_bot_username

# Settings
DEBUG=false
